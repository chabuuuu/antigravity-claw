# =======================================================
# Antigravity OpenClaw - Environment Configuration
# =======================================================

# Server Host and Port
OPENCLAW_HOST=0.0.0.0
OPENCLAW_PORT=8080
OPENCLAW_DEBUG=false

# Workspace Directory (Directory the agent will browse and edit)
OPENCLAW_WORKSPACE=/home/ubuntu/projects

# Antigravity CLI Binary Path (Defaults to auto-detecting ~/.gemini/bin/agy or agy in PATH)
# AGY_BIN_PATH=/home/ubuntu/.gemini/bin/agy

# Database Path
OPENCLAW_DB_PATH=data/openclaw.db

# JWT Security (Auto-generated and saved to data/.jwt_secret if omitted)
# OPENCLAW_JWT_SECRET=your-super-secret-random-hex-key-here
OPENCLAW_JWT_EXPIRY_HOURS=72

# Security & Rate Limiting (Brute Force Defense)
OPENCLAW_MAX_LOGIN_ATTEMPTS=5
OPENCLAW_LOCKOUT_MINUTES=15

# Autonomous Notification Webhooks (Optional)
OPENCLAW_TELEGRAM_BOT_TOKEN=
OPENCLAW_TELEGRAM_CHAT_ID=
OPENCLAW_DISCORD_WEBHOOK_URL=
OPENCLAW_SLACK_WEBHOOK_URL=
OPENCLAW_GENERIC_WEBHOOK_URL=

